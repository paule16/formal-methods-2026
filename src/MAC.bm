machine MAC
    refines DAC_EXT
    sees MAC_CTX open xattrs

variables
    Users
    Groups
    Procs
    Files
    Folders
    SymLinks
    FDs
    FileParents
    FileLink
    ProcFDs
    FDFlags
    FDFile
    FDNumber
    DACPermissions // ACL_USER_OBJ и ACL_OTHER явно в модели не описываются, так как им соответствуют обычные file permission bits (DACPermissions)
    UserACL // ACL_USER - denote access rights for users identified by the entry's qualifier
    GroupObjACL // ACL_GROUP_OBJ - denotes access rights for the file group
    GroupACL // ACL_GROUP - denote access rights for groups identified by the entry's qualifier
    MaskACL // ACL_MASK - denotes the maximum access rights that can be granted by entries of type ACL_USER, ACL_GROUP_OBJ, or ACL_GROUP
    FileUser
    FileGroup
    ProcUser
    ProcGroup
    ProcUmask
    FileXattrs
    ProcEXE
    ProcArgv
    ProcEnvp
    ProcCwd
    ProcParent
    UserGroups
    PathToRoot
    UserCaps
    ProcLabel // Smack метка процесса (субъекта)
    FileLabel // Smack метка файла (объекта)
    FileExecLabel // Smack метка, присваиваемая процессу, после выполнения exec данного файла
    SmackRules // Smack правила доступа субъектов к объектам
    TransmuteFolders

invariants
    @inv1: ProcLabel ∈ Procs → STRINGS
    @inv2: FileLabel ∈ Files → STRINGS
    @inv3: SmackRules ⊆ STRINGS × STRINGS × ACCESSES
    @inv4: FileExecLabel ∈ Files ⇸ STRINGS
    @inv5: TransmuteFolders ⊆ Folders

events

    event INITIALISATION extends INITIALISATION
    then
        @act33: ProcLabel ≔ {INIT ↦ INIT_LABEL}
        @act34: FileLabel ≔ {ROOT ↦ ROOT_LABEL, INIT_EXE ↦ INIT_EXE_LABEL}
        @act35: SmackRules ≔ ∅
        @act36: FileExecLabel ≔ ∅
        @act37: TransmuteFolders ≔ ∅
    end

    event open_create extends open_create
    any
        fileLabel // -
    where
        @grd26: ProcUser(proc) ≠ ROOT_USER ⇒
            (∀ f · f ∈ PathToRoot(parent) ∪ {parent} ⇒
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    ProcLabel(proc) = HAT ∨
                    FileLabel(f) = FLOOR ∨
                    FileLabel(f) = STAR ∨
                    ProcLabel(proc) = FileLabel(f) ∨
                    EXECUTE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(f)}]
                )
            ) // проверка прав доступа на выполнение к каждой директории на пути от
              // родительской к корневой директории согласно правилам из
              // документации Smack
        @grd27: ProcUser(proc) ≠ ROOT_USER ⇒
            (
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    FileLabel(parent) = STAR ∨
                    ProcLabel(proc) = FileLabel(parent) ∨
                    WRITE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(parent)}]
                )
            ) // для самой родительской директории осталось только проверить права на запись
        @grd28: (parent ∈ TransmuteFolders ∧ TRANSMUTE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(parent)}] ∧
                fileLabel = FileLabel(parent)) ∨
                fileLabel = ProcLabel(proc) // Если SMACK64TRANSMUTE аттрибут установлен для родительской директории
                                            // и правило содержит TRANSMUTE, то файл получает метку родительской
                                            // директории, иначе -- процесса.
    then
        @act13: FileLabel(file) ≔ fileLabel
    end

    event open_exists extends open_exists
    where
        @grd24: ProcUser(proc) ≠ ROOT_USER ⇒
            (∀ f · f ∈ PathToRoot(parent) ∪ {parent} ⇒
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    ProcLabel(proc) = HAT ∨
                    FileLabel(f) = FLOOR ∨
                    FileLabel(f) = STAR ∨
                    ProcLabel(proc) = FileLabel(f) ∨
                    EXECUTE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(f)}]
                )
            ) // проверка прав доступа на выполнение к каждой директории на пути от
              // родительской к корневой директории
        @grd25: ProcUser(proc) ≠ ROOT_USER ∧ (O_RDONLY ∈ flags ∨ O_RDWR ∈ flags) ∧ O_PATH ∉ flags ⇒
            (
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    ProcLabel(proc) = HAT ∨
                    FileLabel(file) = FLOOR ∨
                    FileLabel(file) = STAR ∨
                    ProcLabel(proc) = FileLabel(file) ∨
                    READ ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(file)}]
                )
            ) // проверка прав доступа на чтение файла
        @grd26: ProcUser(proc) ≠ ROOT_USER ∧ (O_WRONLY ∈ flags ∨ O_RDWR ∈ flags) ∧ O_PATH ∉ flags ⇒
            (
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    FileLabel(file) = STAR ∨
                    ProcLabel(proc) = FileLabel(file) ∨
                    WRITE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(file)}]
                )
            ) // проверка прав доступа на запись в файл
    end

    event openat_create extends openat_create
    any
        fileLabel
    where
        @grd32: ProcUser(proc) ≠ ROOT_USER ⇒
            (∀ f · f ∈ PathToRoot(parent) ∪ {parent} ⇒
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    ProcLabel(proc) = HAT ∨
                    FileLabel(f) = FLOOR ∨
                    FileLabel(f) = STAR ∨
                    ProcLabel(proc) = FileLabel(f) ∨
                    EXECUTE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(f)}]
                )
            ) // проверка прав доступа на выполнение к каждой директории на пути от
              // родительской к корневой директории согласно правилам из
              // документации Smack
        @grd33: ProcUser(proc) ≠ ROOT_USER ⇒
            (
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    FileLabel(parent) = STAR ∨
                    ProcLabel(proc) = FileLabel(parent) ∨
                    WRITE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(parent)}]
                )
            ) // для самой родительской директории осталось только проверить права на запись
        @grd34: (parent ∈ TransmuteFolders ∧ TRANSMUTE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(parent)}] ∧
                fileLabel = FileLabel(parent)) ∨
                fileLabel = ProcLabel(proc) // Если SMACK64TRANSMUTE аттрибут установлен для родительской директории
                                            // и правило содержит TRANSMUTE, то файл получает метку родительской
                                            // директории, иначе -- процесса.
    then
        @act13: FileLabel(file) ≔ fileLabel
    end

    event creat extends creat
    any
        fileLabel
    where
        @grd26: ProcUser(proc) ≠ ROOT_USER ⇒
            (∀ f · f ∈ PathToRoot(parent) ∪ {parent} ⇒
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    ProcLabel(proc) = HAT ∨
                    FileLabel(f) = FLOOR ∨
                    FileLabel(f) = STAR ∨
                    ProcLabel(proc) = FileLabel(f) ∨
                    EXECUTE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(f)}]
                )
            ) // проверка прав доступа на выполнение к каждой директории на пути от
              // родительской к корневой директории согласно правилам из
              // документации Smack
        @grd27: ProcUser(proc) ≠ ROOT_USER ⇒
            (
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    FileLabel(parent) = STAR ∨
                    ProcLabel(proc) = FileLabel(parent) ∨
                    WRITE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(parent)}]
                )
            ) // для самой родительской директории осталось только проверить права на запись
        @grd28: (parent ∈ TransmuteFolders ∧ TRANSMUTE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(parent)}] ∧
                fileLabel = FileLabel(parent)) ∨
                fileLabel = ProcLabel(proc) // Если SMACK64TRANSMUTE аттрибут установлен для родительской директории
                                            // и правило содержит TRANSMUTE, то файл получает метку родительской
                                            // директории, иначе -- процесса.
    then
        @act13: FileLabel(file) ≔ fileLabel
    end


    event openat_exists extends openat_exists // in case of absolute pathname you need to call open_create or open_exists
    where
        @grd28: ProcUser(proc) ≠ ROOT_USER ⇒
            (∀ f · f ∈ PathToRoot(parent) ∪ {parent} ⇒
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    ProcLabel(proc) = HAT ∨
                    FileLabel(f) = FLOOR ∨
                    FileLabel(f) = STAR ∨
                    ProcLabel(proc) = FileLabel(f) ∨
                    EXECUTE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(f)}]
                )
            ) // проверка прав доступа на выполнение к каждой директории на пути от
              // родительской к корневой директории
        @grd29: ProcUser(proc) ≠ ROOT_USER ∧ (O_RDONLY ∈ flags ∨ O_RDWR ∈ flags) ∧ O_PATH ∉ flags ⇒
            (
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    ProcLabel(proc) = HAT ∨
                    FileLabel(file) = FLOOR ∨
                    FileLabel(file) = STAR ∨
                    ProcLabel(proc) = FileLabel(file) ∨
                    READ ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(file)}]
                )
            ) // проверка прав доступа на чтение файла
        @grd30: ProcUser(proc) ≠ ROOT_USER ∧ (O_WRONLY ∈ flags ∨ O_RDWR ∈ flags) ∧ O_PATH ∉ flags ⇒
            (
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    FileLabel(file) = STAR ∨
                    ProcLabel(proc) = FileLabel(file) ∨
                    WRITE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(file)}]
                )
            ) // проверка прав доступа на запись в файл
    end

    event mkdir extends mkdir // TODO: add support for mkdirat?
    any
        fileLabel
        newTransmute
    where
        @grd14: ProcUser(proc) ≠ ROOT_USER ⇒
            (∀ f · f ∈ PathToRoot(parent) ∪ {parent} ⇒
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    ProcLabel(proc) = HAT ∨
                    FileLabel(f) = FLOOR ∨
                    FileLabel(f) = STAR ∨
                    ProcLabel(proc) = FileLabel(f) ∨
                    EXECUTE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(f)}]
                )
            ) // проверка прав доступа на выполнение к каждой директории на пути от
              // родительской к корневой директории согласно правилам из
              // документации Smack
        @grd15: ProcUser(proc) ≠ ROOT_USER ⇒
            (
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    FileLabel(parent) = STAR ∨
                    ProcLabel(proc) = FileLabel(parent) ∨
                    WRITE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(parent)}]
                )
            ) // для самой родительской директории осталось только проверить права на запись
        @grd16: newTransmute ⊆ FILES
        @grd17: (parent ∈ TransmuteFolders ∧ TRANSMUTE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(parent)}] ∧
                fileLabel = FileLabel(parent) ∧ newTransmute = {folder}) ∨
                (fileLabel = ProcLabel(proc) ∧ newTransmute = ∅) // Если SMACK64TRANSMUTE аттрибут
                                                                 // установлен для родительской директории
                                                                 // и правило содержит TRANSMUTE, то новая
                                                                 // директория получает аттрибут
                                                                 // SMACK64TRANSMUTE и метку родительской
                                                                 // директории, иначе -- процесса.
    then
        @act10: FileLabel(folder) ≔ fileLabel
        @act11: TransmuteFolders ≔ TransmuteFolders ∪ newTransmute
    end

    event chmod extends chmod // TODO: уточнить условия
    where
        @grd8: ProcUser(proc) ≠ ROOT_USER ⇒
            (∀ f · f ∈ PathToRoot(parent) ∪ {parent} ⇒
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    ProcLabel(proc) = HAT ∨
                    FileLabel(f) = FLOOR ∨
                    FileLabel(f) = STAR ∨
                    ProcLabel(proc) = FileLabel(f) ∨
                    EXECUTE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(f)}]
                )
            ) // проверка прав доступа на выполнение к каждой директории на пути от
              // родительской к корневой директории
    end

    event fchmod extends fchmod
    end

    event fchmodat extends fchmodat
    where
        @grd12: ProcUser(proc) ≠ ROOT_USER ⇒
            (∀ f · f ∈ PathToRoot(parent) ∪ {parent} ⇒
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    ProcLabel(proc) = HAT ∨
                    FileLabel(f) = FLOOR ∨
                    FileLabel(f) = STAR ∨
                    ProcLabel(proc) = FileLabel(f) ∨
                    EXECUTE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(f)}]
                )
            ) // проверка прав доступа на выполнение к каждой директории на пути от
              // родительской к корневой директории
    end

    event chown extends chown
    where
        @grd12: ProcUser(proc) ≠ ROOT_USER ⇒
            (∀ f · f ∈ PathToRoot(parent) ∪ {parent} ⇒
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    ProcLabel(proc) = HAT ∨
                    FileLabel(f) = FLOOR ∨
                    FileLabel(f) = STAR ∨
                    ProcLabel(proc) = FileLabel(f) ∨
                    EXECUTE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(f)}]
                )
            ) // проверка прав доступа на выполнение к каждой директории на пути от
              // родительской к корневой директории
    end

    event fchown extends fchown
    end

    event fchownat extends fchownat
    where
        @grd16: ProcUser(proc) ≠ ROOT_USER ⇒
            (∀ f · f ∈ PathToRoot(parent) ∪ {parent} ⇒
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    ProcLabel(proc) = HAT ∨
                    FileLabel(f) = FLOOR ∨
                    FileLabel(f) = STAR ∨
                    ProcLabel(proc) = FileLabel(f) ∨
                    EXECUTE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(f)}]
                )
            ) // проверка прав доступа на выполнение к каждой директории на пути от
              // родительской к корневой директории
    end

    event chdir extends chdir
    where
        @grd4: ProcUser(proc) ≠ ROOT_USER ⇒
            (∀ f · f ∈ PathToRoot(dir) ∪ {dir} ⇒
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    ProcLabel(proc) = HAT ∨
                    FileLabel(f) = FLOOR ∨
                    FileLabel(f) = STAR ∨
                    ProcLabel(proc) = FileLabel(f) ∨
                    EXECUTE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(f)}]
                )
            ) // проверка прав доступа на выполнение к каждой директории на пути от
              // директории к корневой директории
    end

    event fchdir extends fchdir
    where
        @grd5: ProcUser(proc) ≠ ROOT_USER ⇒
            (
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    ProcLabel(proc) = HAT ∨
                    FileLabel(FDFile(fd)) = FLOOR ∨
                    FileLabel(FDFile(fd)) = STAR ∨
                    ProcLabel(proc) = FileLabel(FDFile(fd)) ∨
                    EXECUTE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(FDFile(fd))}]
                )
            ) // проверка прав доступа на выполнение к директории
    end

    event getdents extends getdents
    end

    event getxattr extends getxattr
    where
        @grd7: ProcUser(proc) ≠ ROOT_USER ⇒
            (∀ f · f ∈ PathToRoot(parent) ∪ {parent} ⇒
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    ProcLabel(proc) = HAT ∨
                    FileLabel(f) = FLOOR ∨
                    FileLabel(f) = STAR ∨
                    ProcLabel(proc) = FileLabel(f) ∨
                    EXECUTE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(f)}]
                )
            ) // проверка прав доступа на выполнение к каждой директории на пути от
              // родительской к корневой директории
        @grd8: ProcUser(proc) ≠ ROOT_USER ⇒
            (
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    ProcLabel(proc) = HAT ∨
                    FileLabel(file) = FLOOR ∨
                    FileLabel(file) = STAR ∨
                    ProcLabel(proc) = FileLabel(file) ∨
                    READ ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(file)}]
                )
            ) // проверка прав доступа на чтение файла
    end

    event setxattr extends setxattr
    where
        @grd10: ProcUser(proc) ≠ ROOT_USER ⇒
            (∀ f · f ∈ PathToRoot(parent) ∪ {parent} ⇒
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    ProcLabel(proc) = HAT ∨
                    FileLabel(f) = FLOOR ∨
                    FileLabel(f) = STAR ∨
                    ProcLabel(proc) = FileLabel(f) ∨
                    EXECUTE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(f)}]
                )
            ) // проверка прав доступа на выполнение к каждой директории на пути от
              // родительской к корневой директории
        @grd11: ProcUser(proc) ≠ ROOT_USER ⇒
            (
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    FileLabel(file) = STAR ∨
                    ProcLabel(proc) = FileLabel(file) ∨
                    WRITE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(file)}]
                )
            ) // проверка прав доступа на запись в файл
    end

    event link extends link
    where
        @grd11: ProcUser(proc) ≠ ROOT_USER ⇒
            (∀ f · f ∈ PathToRoot(oldParent) ∪ {oldParent} ⇒
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    ProcLabel(proc) = HAT ∨
                    FileLabel(f) = FLOOR ∨
                    FileLabel(f) = STAR ∨
                    ProcLabel(proc) = FileLabel(f) ∨
                    EXECUTE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(f)}]
                )
            ) // проверка прав доступа на выполнение к каждой директории на пути от
              // родительской к корневой директории
        @grd12: ProcUser(proc) ≠ ROOT_USER ⇒
            (∀ f · f ∈ PathToRoot(newParent) ∪ {newParent} ⇒
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    ProcLabel(proc) = HAT ∨
                    FileLabel(f) = FLOOR ∨
                    FileLabel(f) = STAR ∨
                    ProcLabel(proc) = FileLabel(f) ∨
                    EXECUTE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(f)}]
                )
            ) // проверка прав доступа на выполнение к каждой директории на пути от
              // родительской к корневой директории
        @grd13: ProcUser(proc) ≠ ROOT_USER ⇒
            (
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    FileLabel(newParent) = STAR ∨
                    ProcLabel(proc) = FileLabel(newParent) ∨
                    WRITE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(newParent)}]
                )
            ) // проверка прав на запись в новую родительскую директорию
        @grd14: ProcUser(proc) ∉ {FileUser(file), ROOT_USER} ⇒
            (
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    ProcLabel(proc) = HAT ∨
                    FileLabel(file) = FLOOR ∨
                    FileLabel(file) = STAR ∨
                    ProcLabel(proc) = FileLabel(file) ∨
                    READ ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(file)}]
                )
            )
        @grd15: ProcUser(proc) ∉ {FileUser(file), ROOT_USER} ⇒
            (
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    FileLabel(file) = STAR ∨
                    ProcLabel(proc) = FileLabel(file) ∨
                    WRITE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(file)}]
                )
            )
    end

    event symlink extends symlink // TODO: add basic symlink support to other syscalls
    where
        @grd10: ProcUser(proc) ≠ ROOT_USER ⇒
            (∀ f · f ∈ PathToRoot(parent) ∪ {parent} ⇒
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    ProcLabel(proc) = HAT ∨
                    FileLabel(f) = FLOOR ∨
                    FileLabel(f) = STAR ∨
                    ProcLabel(proc) = FileLabel(f) ∨
                    EXECUTE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(f)}]
                )
            ) // проверка прав доступа на выполнение к каждой директории на пути от
              // родительской к корневой директории
        @grd11: ProcUser(proc) ≠ ROOT_USER ⇒
            (
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    FileLabel(parent) = STAR ∨
                    ProcLabel(proc) = FileLabel(parent) ∨
                    WRITE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(parent)}]
                )
            ) // проверка прав на запись в родительскую директорию
    then
        @act10: FileLabel(file) ≔ ProcLabel(proc) // TODO: directory label transition
    end

    event execve extends execve // TODO: support #!interpreter
    any
        procNewLabel // -
    where
        @grd12: ProcUser(proc) ≠ ROOT_USER ⇒
            (∀ f · f ∈ PathToRoot(parent) ∪ {parent, exeFile} ⇒
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    ProcLabel(proc) = HAT ∨
                    FileLabel(f) = FLOOR ∨
                    FileLabel(f) = STAR ∨
                    ProcLabel(proc) = FileLabel(f) ∨
                    EXECUTE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(f)}]
                )
            ) // проверка прав доступа на выполнение к каждой директории на пути от
              // родительской к корневой директории, а также к исполняемому файлу
        @grd13: (exeFile ∈ dom(FileExecLabel) ∧ procNewLabel = FileExecLabel(exeFile)) ∨ procNewLabel = ProcLabel(proc)
    then
        @act11: ProcLabel(proc) ≔ procNewLabel
    end

    event umask extends umask
    end

    event exit extends exit
    then
        @act15: ProcLabel ≔ {proc} ⩤ ProcLabel
    end

    event close extends close
    end

    event unlink extends unlink
    where
        @grd11: ProcUser(proc) ≠ ROOT_USER ⇒
            (∀ f · f ∈ PathToRoot(parent) ∪ {parent} ⇒
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    ProcLabel(proc) = HAT ∨
                    FileLabel(f) = FLOOR ∨
                    FileLabel(f) = STAR ∨
                    ProcLabel(proc) = FileLabel(f) ∨
                    EXECUTE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(f)}]
                )
            ) // проверка прав доступа на выполнение к каждой директории на пути от
              // родительской к корневой директории
        @grd12: ProcUser(proc) ≠ ROOT_USER ⇒
            (
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    FileLabel(parent) = STAR ∨
                    ProcLabel(proc) = FileLabel(parent) ∨
                    WRITE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(parent)}]
                )
            ) // проверка прав на запись в родительскую директорию
    then
        @act13: FileLabel ≔ files ⩤ FileLabel
        @act14: FileExecLabel ≔ files ⩤ FileExecLabel
    end

    event rmdir extends rmdir
    where
        @grd9:  ProcUser(proc) ≠ ROOT_USER ⇒
            (∀ f · f ∈ PathToRoot(parent) ∪ {parent} ⇒
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    ProcLabel(proc) = HAT ∨
                    FileLabel(f) = FLOOR ∨
                    FileLabel(f) = STAR ∨
                    ProcLabel(proc) = FileLabel(f) ∨
                    EXECUTE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(f)}]
                )
            ) // проверка прав доступа на выполнение к каждой директории на пути от
              // родительской к корневой директории
        @grd10: ProcUser(proc) ≠ ROOT_USER ⇒
            (
                ¬(ProcLabel(proc) = STAR) ∧
                (
                    FileLabel(parent) = STAR ∨
                    ProcLabel(proc) = FileLabel(parent) ∨
                    WRITE ∈ SmackRules[{ProcLabel(proc) ↦ FileLabel(parent)}]
                )
            ) // проверка прав на запись в родительскую директорию
    then
        @act13: FileLabel ≔ {folder} ⩤ FileLabel
        @act14: FileExecLabel ≔ {folder} ⩤ FileExecLabel
        @act15: TransmuteFolders ≔ TransmuteFolders ∖ {folder}
    end

    event fork extends fork
    then
        @act11: ProcLabel(newProc) ≔ ProcLabel(proc)
    end

    event create_user extends create_user
    end

    event create_group extends create_group
    end

    event login extends login // create first user process
    any
        procLabel
    where
        @grd8: (exeFile ∈ dom(FileExecLabel) ∧ procLabel = FileExecLabel(exeFile)) ∨ procLabel = ProcLabel(INIT)
    then
        @act10: ProcLabel(proc) ≔ procLabel
    end

    event set_file_label
    any
        file
        label
    where
        @grd1: file ∈ Files
        @grd2: label ∈ STRINGS
    then
        @act1: FileLabel(file) ≔ label
    end

    event set_file_exec_label
    any
        file
        label
    where
        @grd1: file ∈ Files
        @grd2: label ∈ STRINGS
    then
        @act1: FileExecLabel(file) ≔ label
    end

    event set_directory_transmute
    any
        dir
    where
        @grd1: dir ∈ Folders
    then
        @act1: TransmuteFolders ≔ TransmuteFolders ∪ {dir}
    end

    event load_rules
    any
        rules
    where
        @grd1: rules ⊆ STRINGS × STRINGS × ACCESSES
    then
        @act1: SmackRules ≔ SmackRules ∪ rules
    end

    event set_acl extends set_acl
    end

    event any_transition extends any_transition
    any
        fProcLabel
        fFileLabel
        fFileExecLabel
        fSmackRules
        fTransmuteFolders
    where
        @grd53: fProcLabel ∈ fProcs → STRINGS
        @grd54: fFileLabel ∈ fFiles → STRINGS
        @grd55: fSmackRules ⊆ STRINGS × STRINGS × ACCESSES
        @grd56: fFileExecLabel ∈ fFiles ⇸ STRINGS
        @grd57: fTransmuteFolders ⊆ fFolders
    then
        @act33: ProcLabel ≔ fProcLabel
        @act34: FileLabel ≔ fFileLabel
        @act35: SmackRules ≔ fSmackRules
        @act36: FileExecLabel ≔ fFileExecLabel
        @act37: TransmuteFolders ≔ fTransmuteFolders
    end

    event change_capabilities extends change_capabilities
    end

    event change_user extends change_user
    end

end
