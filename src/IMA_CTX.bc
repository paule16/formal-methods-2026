context IMA_CTX
    extends DAC_CTX

sets
    INTEGRITY_MODES
    HASHES

constants
    ENFORCE
    FIX
    OFF
    IMA_STRING // security.ima
    EVM_STRING // security.evm

axioms
    @INTEGRITY_MODES_partition: partition(INTEGRITY_MODES, {ENFORCE}, {FIX}, {OFF})
    @IMA_STRING_type:           IMA_STRING ∈ STRINGS
    @EVM_STRING_type:           EVM_STRING ∈ STRINGS

end
