    <org.eventb.core.guard name="147" org.eventb.core.comment="@const лимит открытых дескрипторов всех процессов еще не исчерпан" org.eventb.core.generated="false" org.eventb.core.label="grd16" org.eventb.core.predicate="card(ran(ProcFDs)) &lt; FILE_LIMIT" org.eventb.core.theorem="false"/>
    <org.eventb.core.guard name="148" org.eventb.core.comment="создавать файл с флагом O_PATH нельзя" org.eventb.core.generated="false" org.eventb.core.label="grd17" org.eventb.core.predicate="O_PATH ∉ flags" org.eventb.core.theorem="false"/>
    <org.eventb.core.guard name="149" org.eventb.core.comment="если open выполнен не от имени суперпользователя, то&#xA;у процесса должно быть право доступа на выполнение&#xA;для каждой директории из пути от родительской директории&#xA;создаваемого файла до корневой директории&#xA;&#xA;проверка происходит по следующему алгоритму:&#xA;1) если пользователь текущего процесса является владельцем директории,&#xA;то у него должно быть право доступа на выполнение к ней&#xA;2) иначе, если маска ACL пустая, перейти на шаг 6 (из-за  бага 2004 года: https://superuser.com/questions/1356849/why-the-access-check-algorithm-from-man-acl-does-not-correspond-to-the-actual)&#xA;3) иначе, если пользователь не владелец, но в UserACL есть запись с директорией и пользователем,&#xA;то в этой записи должно быть право доступа на выполнение и маска ACL должна разрешать такой доступ&#xA;4) иначе если нет записи и в UserACL, но есть в GroupACL или GroupObjACL для директории и группы пользователя,&#xA;то в этой записи должно быть право доступа на выполнение и маска ACL должна разрешать такой доступ&#xA;5) иначе если нет маски, то есть запись о группе в GroupObjACL,&#xA;то в этой записи должно быть право доступа на выполнение&#xA;6) иначе право доступа ищется в поле other DAC" org.eventb.core.generated="false" org.eventb.core.label="grd18" org.eventb.core.predicate="∀f · f ∈ PathToRoot(parent) ∧ ProcUser(proc) ≠ ROOT_USER&#xA;&#x9;⇒ ((ProcUser(proc) = FileUser(f)&#xA;&#x9;&#x9;&#x9;∧ UEXECUTE ∈ DACPermissions(f))&#xA;&#x9;&#x9;∨ (ProcUser(proc) ≠ FileUser(f)&#xA;&#x9;&#x9;&#x9;∧ (f ∉ dom(MaskACL) ∨ MaskACL(f) = ∅)&#xA;&#x9;&#x9;&#x9;∧ FileGroup(f) ≠ ProcGroup(proc) ∧ ProcUser(proc) ↦ FileGroup(f) ∉ UserGroups&#xA;&#x9;&#x9;&#x9;∧ OEXECUTE ∈ DACPermissions(f))&#xA;&#x9;&#x9;∨ (ProcUser(proc) ≠ FileUser(f)&#xA;&#x9;&#x9;&#x9;∧ f ↦ ProcUser(proc) ∈ dom(UserACL) ∧ UEXECUTE ∈ UserACL(f ↦ ProcUser(proc))&#xA;&#x9;&#x9;&#x9;∧ GEXECUTE ∈ MaskACL(f))&#xA;&#x9;&#x9;∨ (ProcUser(proc) ≠ FileUser(f)&#xA;&#x9;&#x9;&#x9;∧ f ↦ ProcUser(proc) ∉ dom(UserACL)&#xA;&#x9;&#x9;&#x9;∧ (∃g · (g ∈ {ProcGroup(proc)} ∪ UserGroups[{ProcUser(proc)}])&#xA;&#x9;&#x9;&#x9;&#x9;∧ ((f ↦ g ∈ dom(GroupACL) ∧ GEXECUTE ∈ GroupACL(f ↦ g)) ∨ (g = FileGroup(f) ∧ f ∈ dom(GroupObjACL) ∧ GEXECUTE ∈ GroupObjACL(f))))&#xA;&#x9;&#x9;&#x9;∧ f ∈ dom(MaskACL) ∧ GEXECUTE ∈ MaskACL(f))&#xA;&#x9;&#x9;∨ (ProcUser(proc) ≠ FileUser(f)&#xA;&#x9;&#x9;&#x9;∧ f ∉ dom(MaskACL)&#xA;&#x9;&#x9;&#x9;∧ (FileGroup(f) = ProcGroup(proc) ∨ ProcUser(proc) ↦ FileGroup(f) ∈ UserGroups)&#xA;&#x9;&#x9;&#x9;∧ GEXECUTE ∈ DACPermissions(f))&#xA;&#x9;&#x9;∨ (ProcUser(proc) ≠ FileUser(f)&#xA;&#x9;&#x9;&#x9;∧ f ∈ dom(MaskACL) ∧ MaskACL(f) ≠ ∅&#xA;&#x9;&#x9;&#x9;∧ f ↦ ProcUser(proc) ∉ dom(UserACL)&#xA;&#x9;&#x9;&#x9;∧ (∀g · (g ∈ {ProcGroup(proc)} ∪ UserGroups[{ProcUser(proc)}]) ⇒ f ↦ g ∉ dom(GroupACL))&#xA;&#x9;&#x9;&#x9;∧ FileGroup(f) ≠ ProcGroup(proc) ∧ ProcUser(proc) ↦ FileGroup(f) ∉ UserGroups&#xA;&#x9;&#x9;&#x9;∧ OEXECUTE ∈ DACPermissions(f)))" org.eventb.core.theorem="false"/>
    <org.eventb.core.guard name="150" org.eventb.core.comment="если open выполнен не от имени суперпользователя, то&#xA;для создания файла требуются права доступа на запись и выполнение к родительской директории&#xA;@depend[[FileGroup(parent)=ProcGroup(proc)]] является следствием  [group=FileGroup(parent)] и [group=ProcGroup(proc)]" org.eventb.core.generated="false" org.eventb.core.label="grd19" org.eventb.core.predicate="ProcUser(proc) ≠ ROOT_USER&#xA;&#x9;⇒ ((ProcUser(proc) = FileUser(parent)&#xA;&#x9;&#x9;&#x9;∧ {UWRITE, UEXECUTE} ⊆ DACPermissions(parent))&#xA;&#x9;&#x9;∨ (ProcUser(proc) ≠ FileUser(parent)&#xA;&#x9;&#x9;&#x9;∧ (parent ∉ dom(MaskACL) ∨ MaskACL(parent) = ∅)&#xA;&#x9;&#x9;&#x9;∧ FileGroup(parent) ≠ ProcGroup(proc) ∧ ProcUser(proc) ↦ FileGroup(parent) ∉ UserGroups&#xA;&#x9;&#x9;&#x9;∧ {OWRITE, OEXECUTE} ⊆ DACPermissions(parent))&#xA;&#x9;&#x9;∨ (ProcUser(proc) ≠ FileUser(parent)&#xA;&#x9;&#x9;&#x9;∧ parent ↦ ProcUser(proc) ∈ dom(UserACL) ∧ {UWRITE, UEXECUTE} ⊆ UserACL(parent ↦ ProcUser(proc))&#xA;&#x9;&#x9;&#x9;∧ {GWRITE, GEXECUTE} ⊆ MaskACL(parent))&#xA;&#x9;&#x9;∨ (ProcUser(proc) ≠ FileUser(parent)&#xA;&#x9;&#x9;&#x9;∧ parent ↦ ProcUser(proc) ∉ dom(UserACL)&#xA;&#x9;&#x9;&#x9;∧ (∃g · (g ∈ {ProcGroup(proc)} ∪ UserGroups[{ProcUser(proc)}])&#xA;&#x9;&#x9;&#x9;&#x9;∧ ((parent ↦ g ∈ dom(GroupACL) ∧ {GWRITE, GEXECUTE} ⊆ GroupACL(parent ↦ g)) ∨ (g = FileGroup(parent) ∧ parent ∈ dom(GroupObjACL) ∧ {GWRITE, GEXECUTE} ⊆ GroupObjACL(parent))))&#xA;&#x9;&#x9;&#x9;∧ parent ∈ dom(MaskACL) ∧ {GWRITE, GEXECUTE} ⊆ MaskACL(parent))&#xA;&#x9;&#x9;∨ (ProcUser(proc) ≠ FileUser(parent)&#xA;&#x9;&#x9;&#x9;∧ parent ∉ dom(MaskACL)&#xA;&#x9;&#x9;&#x9;∧ (FileGroup(parent) = ProcGroup(proc) ∨ ProcUser(proc) ↦ FileGroup(parent) ∈ UserGroups)&#xA;&#x9;&#x9;&#x9;∧ {GWRITE, GEXECUTE} ⊆ DACPermissions(parent))&#xA;&#x9;&#x9;∨ (ProcUser(proc) ≠ FileUser(parent)&#xA;&#x9;&#x9;&#x9;∧ parent ∈ dom(MaskACL) ∧ MaskACL(parent) ≠ ∅&#xA;&#x9;&#x9;&#x9;∧ parent ↦ ProcUser(proc) ∉ dom(UserACL)&#xA;&#x9;&#x9;&#x9;∧ (∀g · (g ∈ {ProcGroup(proc)} ∪ UserGroups[{ProcUser(proc)}]) ⇒ parent ↦ g ∉ dom(GroupACL))&#xA;&#x9;&#x9;&#x9;∧ FileGroup(parent) ≠ ProcGroup(proc) ∧ ProcUser(proc) ↦ FileGroup(parent) ∉ UserGroups&#xA;&#x9;&#x9;&#x9;∧ {OWRITE, OEXECUTE} ⊆ DACPermissions(parent)))" org.eventb.core.theorem="false"/>
    <org.eventb.core.guard name="151" org.eventb.core.comment="@const" org.eventb.core.generated="false" org.eventb.core.label="grd20" org.eventb.core.predicate="group ∈ Groups" org.eventb.core.theorem="false"/>
    <org.eventb.core.guard name="152" org.eventb.core.comment="если флага SET_GID нет на родительской директории,&#xA;то группой создаваемого файла будет группа текущего процесса" org.eventb.core.generated="false" org.eventb.core.label="grd21" org.eventb.core.predicate="SET_GID ∉ DACPermissions(parent) ⇒ group = ProcGroup(proc)" org.eventb.core.theorem="false"/>
    <org.eventb.core.guard name="153" org.eventb.core.comment="если флаг SET_GID есть на родительской директории,&#xA;то группой создаваемого файла будет группа родительской директории" org.eventb.core.generated="false" org.eventb.core.label="grd22" org.eventb.core.predicate="SET_GID ∈ DACPermissions(parent) ⇒ group = FileGroup(parent)" org.eventb.core.theorem="false"/>
    <org.eventb.core.guard name="154" org.eventb.core.comment="@const права доступа создаваемого файла ограничиваются маской процесса" org.eventb.core.generated="false" org.eventb.core.label="grd23" org.eventb.core.predicate="perms = mode ∖ (mode ∩ ProcUmask(proc))" org.eventb.core.theorem="false"/>
    <org.eventb.core.action name="155" org.eventb.core.generated="false" org.eventb.core.label="act1" org.eventb.core.assignment="Files ≔ Files ∪ {file}"/>
    <org.eventb.core.action name="156" org.eventb.core.generated="false" org.eventb.core.label="act2" org.eventb.core.assignment="FileParents ≔ FileParents ∪ {file ↦ (parent ↦ name)}"/>
    <org.eventb.core.action name="157" org.eventb.core.generated="false" org.eventb.core.label="act3" org.eventb.core.assignment="FDs ≔ FDs ∪ {fd}"/>
    <org.eventb.core.action name="158" org.eventb.core.generated="false" org.eventb.core.label="act4" org.eventb.core.assignment="FDNumber(fd) ≔ fdNumber"/>
    <org.eventb.core.action name="159" org.eventb.core.generated="false" org.eventb.core.label="act5" org.eventb.core.assignment="ProcFDs ≔ ProcFDs ∪ {proc ↦ fd}"/>
