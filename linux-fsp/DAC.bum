    <org.eventb.core.parameter name="131" org.eventb.core.comment="- итоговые права доступа, с которыми будет создан файл (параметр не указывается явно в ProB)" org.eventb.core.generated="false" org.eventb.core.identifier="perms"/>
    <org.eventb.core.guard name="132" org.eventb.core.comment="@const" org.eventb.core.generated="false" org.eventb.core.label="grd1" org.eventb.core.predicate="proc ∈ Procs" org.eventb.core.theorem="false"/>
    <org.eventb.core.guard name="133" org.eventb.core.generated="false" org.eventb.core.label="grd2" org.eventb.core.predicate="parent ∈ Folders" org.eventb.core.theorem="false"/>
    <org.eventb.core.guard name="134" org.eventb.core.comment="@const файл не присутсвует в системе ни в каком виде" org.eventb.core.generated="false" org.eventb.core.label="grd3" org.eventb.core.predicate="file ∈ ((FILES ∖ Files) ∖ ran(FDFile)) ∖ ran(ProcCwd)" org.eventb.core.theorem="false"/>
    <org.eventb.core.guard name="135" org.eventb.core.comment="@const с таким именем в переданной директории нет ни одного файла" org.eventb.core.generated="false" org.eventb.core.label="grd4" org.eventb.core.predicate="∀f · f ∈ dom(FileParents) ⇒ f ↦ (parent ↦ name) ∉ FileParents" org.eventb.core.theorem="false"/>
