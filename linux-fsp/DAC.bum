    <org.eventb.core.guard name="138" org.eventb.core.comment="@const" org.eventb.core.generated="false" org.eventb.core.label="grd7" org.eventb.core.predicate="fd ∈ FILE_DESCRIPTORS ∖ FDs" org.eventb.core.theorem="false"/>
    <org.eventb.core.guard name="139" org.eventb.core.comment="@const" org.eventb.core.generated="false" org.eventb.core.label="grd8" org.eventb.core.predicate="fdNumber ∈ ℕ" org.eventb.core.theorem="false"/>
    <org.eventb.core.guard name="140" org.eventb.core.comment="@const номер нового дескриптора уникален для процесса" org.eventb.core.generated="false" org.eventb.core.label="grd9" org.eventb.core.predicate="∀pfd · proc ↦ pfd ∈ ProcFDs ⇒ FDNumber(pfd) ≠ fdNumber" org.eventb.core.theorem="false"/>
    <org.eventb.core.guard name="141" org.eventb.core.comment="один из этих флагов должен быть выставлен, чтобы выполнение пошло по пути open_create" org.eventb.core.generated="false" org.eventb.core.label="grd10" org.eventb.core.predicate="O_CREAT ∈ flags ∨ O_TMPFILE ∈ flags" org.eventb.core.theorem="false"/>
    <org.eventb.core.guard name="142" org.eventb.core.comment="данные флаги взаимоисключаемы" org.eventb.core.generated="false" org.eventb.core.label="grd11" org.eventb.core.predicate="O_RDONLY ∈ flags ∨ O_WRONLY ∈ flags ∨ O_RDWR ∈ flags" org.eventb.core.theorem="false"/>
    <org.eventb.core.guard name="143" org.eventb.core.comment="данные флаги не могут быть выставлены одновременно" org.eventb.core.generated="false" org.eventb.core.label="grd12" org.eventb.core.predicate="¬(O_RDONLY ∈ flags ∧ O_WRONLY ∈ flags)&#xA;&#x9;∧ ¬(O_RDONLY ∈ flags ∧ O_RDWR ∈ flags)&#xA;&#x9;∧ ¬(O_WRONLY ∈ flags ∧ O_RDWR ∈ flags)" org.eventb.core.theorem="false"/>
    <org.eventb.core.guard name="144" org.eventb.core.comment="временный файл можно открывать только на запись" org.eventb.core.generated="false" org.eventb.core.label="grd13" org.eventb.core.predicate="O_TMPFILE ∈ flags ⇒ (O_WRONLY ∈ flags ∨ O_RDWR ∈ flags)" org.eventb.core.theorem="false"/>
