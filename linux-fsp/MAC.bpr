        <org.eventb.core.prPred name="p25" org.eventb.core.predicate="ProcUser(proc)≠ROOT_USER∧O_RDWR∈flags∧O_PATH∉flags⇒(ProcUser(proc)=FileUser(file)∧{UREAD,UWRITE}⊆DACPermissions(file))∨(ProcUser(proc)≠FileUser(file)∧(file∉dom(MaskACL)∨MaskACL(file)=(∅ ⦂ ℙ(PERMISSIONS)))∧FileGroup(file)≠ProcGroup(proc)∧ProcUser(proc) ↦ FileGroup(file)∉UserGroups∧{OREAD,OWRITE}⊆DACPermissions(file))∨(ProcUser(proc)≠FileUser(file)∧file ↦ ProcUser(proc)∈dom(UserACL)∧{UREAD,UWRITE}⊆UserACL(file ↦ ProcUser(proc))∧{GREAD,GWRITE}⊆MaskACL(file))∨(ProcUser(proc)≠FileUser(file)∧file ↦ ProcUser(proc)∉dom(UserACL)∧(∃g⦂GROUPS·g∈{ProcGroup(proc)}∪UserGroups[{ProcUser(proc)}]∧((file ↦ g∈dom(GroupACL)∧{GREAD,GWRITE}⊆GroupACL(file ↦ g))∨(g=FileGroup(file)∧file∈dom(GroupObjACL)∧{GREAD,GWRITE}⊆GroupObjACL(file))))∧file∈dom(MaskACL)∧{GREAD,GWRITE}⊆MaskACL(file))∨(ProcUser(proc)≠FileUser(file)∧file∉dom(MaskACL)∧(FileGroup(file)=ProcGroup(proc)∨ProcUser(proc) ↦ FileGroup(file)∈UserGroups)∧{GREAD,GWRITE}⊆DACPermissions(file))∨(ProcUser(proc)≠FileUser(file)∧file∈dom(MaskACL)∧MaskACL(file)≠(∅ ⦂ ℙ(PERMISSIONS))∧file ↦ ProcUser(proc)∉dom(UserACL)∧(∀g⦂GROUPS·g∈{ProcGroup(proc)}∪UserGroups[{ProcUser(proc)}]⇒file ↦ g∉dom(GroupACL))∧FileGroup(file)≠ProcGroup(proc)∧ProcUser(proc) ↦ FileGroup(file)∉UserGroups∧{OREAD,OWRITE}⊆DACPermissions(file))"/>
        <org.eventb.core.prPred name="p259" org.eventb.core.predicate="PERMISSIONS={UREAD,UWRITE,UEXECUTE}∪{GREAD,GWRITE,GEXECUTE}∪{OREAD,OWRITE,OEXECUTE}∪{SET_UID,SET_GID,STICKY_BIT}"/>
