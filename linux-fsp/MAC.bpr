        <org.eventb.core.prPred name="p267" org.eventb.core.predicate="∀f⦂FILES·f∈PathToRoot(parent)∧¬⊥⇒(ProcUser(proc)=FileUser(f)∧UEXECUTE∈DACPermissions(f))∨(¬ProcUser(proc)=FileUser(f)∧(¬f∈dom(MaskACL)∨MaskACL(f)=(∅ ⦂ ℙ(PERMISSIONS)))∧¬FileGroup(f)=ProcGroup(proc)∧¬ProcUser(proc) ↦ FileGroup(f)∈UserGroups∧OEXECUTE∈DACPermissions(f))∨(¬ProcUser(proc)=FileUser(f)∧f ↦ ProcUser(proc)∈dom(UserACL)∧UEXECUTE∈UserACL(f ↦ ProcUser(proc))∧GEXECUTE∈MaskACL(f))∨(¬ProcUser(proc)=FileUser(f)∧¬f ↦ ProcUser(proc)∈dom(UserACL)∧(∃g⦂GROUPS·g∈{ProcGroup(proc)}∪UserGroups[{ProcUser(proc)}]∧((f ↦ g∈dom(GroupACL)∧GEXECUTE∈GroupACL(f ↦ g))∨(g=FileGroup(f)∧f∈dom(GroupObjACL)∧GEXECUTE∈GroupObjACL(f))))∧f∈dom(MaskACL)∧GEXECUTE∈MaskACL(f))∨(¬ProcUser(proc)=FileUser(f)∧¬f∈dom(MaskACL)∧(FileGroup(f)=ProcGroup(proc)∨ProcUser(proc) ↦ FileGroup(f)∈UserGroups)∧GEXECUTE∈DACPermissions(f))∨(¬ProcUser(proc)=FileUser(f)∧f∈dom(MaskACL)∧¬MaskACL(f)=(∅ ⦂ ℙ(PERMISSIONS))∧¬f ↦ ProcUser(proc)∈dom(UserACL)∧(∀g⦂GROUPS·g∈{ProcGroup(proc)}∪UserGroups[{ProcUser(proc)}]⇒¬f ↦ g∈dom(GroupACL))∧¬FileGroup(f)=ProcGroup(proc)∧¬ProcUser(proc) ↦ FileGroup(f)∈UserGroups∧OEXECUTE∈DACPermissions(f))"/>
